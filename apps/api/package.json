{
  "name": "@genbreedai/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import=@swc-node/register/esm-register src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --import=@swc-node/register/esm-register src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'skip'",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --import=@swc-node/register/esm-register src/db/migrate.ts",
    "db:seed": "node --import=@swc-node/register/esm-register src/db/seed.ts",
    "db:reset": "node --import=@swc-node/register/esm-register src/db/reset.ts",
    "db:backfill-sex": "node --import=@swc-node/register/esm-register src/db/backfill-sex.ts",
    "images:seed": "node --import=@swc-node/register/esm-register src/images/seed-portraits.ts",
    "start:prod": "node --import=@swc-node/register/esm-register src/main.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.658.1",
    "@genbreedai/engine": "workspace:*",
    "@genbreedai/shared": "workspace:*",
    "@nestjs/common": "^10.4.4",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-fastify": "^10.4.4",
    "@swc-node/register": "^1.10.9",
    "@swc/core": "^1.7.35",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "drizzle-orm": "^0.36.4",
    "fastify": "^4.28.1",
    "google-auth-library": "^9.14.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "stripe": "^22.6.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.14",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.7.5",
    "@types/pg": "^8.11.10",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.28.1",
    "typescript": "^5.6.3",
    "unplugin-swc": "^1.5.1",
    "vitest": "^2.1.9"
  }
}