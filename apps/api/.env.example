# Copie para .env e preencha com a URL do seu Postgres (Neon).
# NUNCA comite o .env real (já está no .gitignore).
# Ex.: postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# OBRIGATÓRIA em produção: com NODE_ENV=production a API NÃO sobe sem uma URL postgres:// válida.
# Fora de produção, vazia = repositórios em MEMÓRIA (os dados NÃO persistem; aviso no log).
DATABASE_URL=
PORT=3001

# Segredo de assinatura do JWT. OBRIGATÓRIO em produção: com NODE_ENV=production a API
# NÃO sobe sem um valor válido (>= 32 caracteres, sem placeholder). Gere: openssl rand -hex 32
# Fora de produção, sem esta variável a API usa um padrão inseguro de dev e avisa no log.
# AUTH_SECRET=

# fal.ai (pipeline de imagem — FLUX.2 [pro], US$0,03/imagem 1024x1024, mesmo
# modelo pra todo tier). Sem esta chave, opera em modo procedural.
# NUNCA comite o .env real. Gere/rotacione a chave no dashboard da fal.ai.
FAL_KEY=
FAL_MODEL=fal-ai/flux-2-pro

# DEV: ignora a cota mensal de imagens (para testar raças sem travar em 403).
# Em NODE_ENV=production é SEMPRE ignorada (mesmo true, com aviso no log) —
# mesmo assim, não a defina em produção.
IMAGE_QUOTA_UNLIMITED=false

# DEV: ignora TODA cota (limite horário de cruzar E cota de revelação,
# ADR-0020 — QuotaService não distingue) para testar sem travar. Em
# NODE_ENV=production esta flag é SEMPRE ignorada (mesmo true), de
# propósito — nunca use em produção, mesmo por engano.
QUOTA_UNLIMITED_DEV=false
# Nome antigo (ADR-0019), ainda aceito por compatibilidade — dava a entender
# (erradamente) que só desligava a cota de cruzamento. Prefira
# QUOTA_UNLIMITED_DEV acima; se as duas estiverem definidas, tanto faz, o
# efeito é o mesmo. Não defina as duas só por precaução — vazio/ausente aqui.
# CROSS_QUOTA_UNLIMITED=false

# Storage de imagens em produção (Cloudflare R2). Sem estas, usa disco local (dev).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=genbreed-images
R2_PUBLIC_URL=

# Web Push — aviso "Gestação concluída" (ADR-0028). OPCIONAL: sem as DUAS chaves o recurso fica desligado
# (a API sobe normal; POST /push/subscribe → 503; `push:dispatch` avisa "DESLIGADO" e não marca nada).
# Gere o par UMA vez: npx web-push generate-vapid-keys  (trocar a chave invalida todas as assinaturas).
# A pública também vai na web como NEXT_PUBLIC_VAPID_PUBLIC_KEY. Requer a dependência `web-push` (a instalar).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:voce@exemplo.com

# DEV: habilita POST /billing/confirm (StubPaymentProvider aprova qualquer pagamento).
# Em NODE_ENV=production é SEMPRE ignorada (mesmo true, com aviso no log) — mas NÃO
# copie este valor pra produção: permitiria creditar a própria carteira de graça.
BILLING_STUB_ENABLED=true

# DEV: aceita x-user-id (sem senha/JWT) e x-user-tier (declara tier pago sem assinatura).
# Em NODE_ENV=production é SEMPRE ignorada (mesmo true, com aviso no log). Só pra dev/testes locais.
# AUTH_DEV_HEADERS=true

# Stripe (billing real — Checkout Session). Sem STRIPE_SECRET_KEY, o billing
# cai no StubPaymentProvider (dev). Catálogo resolvido por lookup_key
# (pack_10_v2/pack_30_v2/pack_60_v2 hoje — catálogo antigo pack_10/pack_50/
# pack_100 foi arquivado no Stripe); nunca hardcode price_id no código.
STRIPE_SECRET_KEY=
# URLs de retorno do Checkout. Em dev, o provider usa defaults de localhost.
# EM PRODUÇÃO (NODE_ENV=production) com STRIPE_SECRET_KEY definida, a API NÃO sobe sem STRIPE_SUCCESS_URL, STRIPE_CANCEL_URL
# (https, nunca localhost) e STRIPE_WEBHOOK_SECRET (abaixo) — ADR-0031, adendo 2. Vale também: VAPID_* só as duas ou nenhuma.
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=

# Segredo do webhook (POST /billing/webhook), pra verificar a assinatura
# stripe-signature. Em dev, `stripe listen --forward-to
# localhost:3001/api/v1/billing/webhook` imprime um whsec_... temporário;
# em produção, vem do endpoint configurado no dashboard da Stripe.
STRIPE_WEBHOOK_SECRET=

# Health check central (ADR-0039): GET /api/v1/health/summary com `Authorization: Bearer <MONITOR_TOKEN>`. Sem MONITOR_TOKEN a rota responde 503.
# MONITOR_TOKEN=            # openssl rand -hex 32
# FAL_ADMIN_KEY=            # chave ADMIN da fal.ai (só para ler o custo do mês; NÃO é a FAL_KEY)
# FAL_MONTHLY_CAP_USD=      # teto de custo mensal da fal.ai; ≥ 80% vira "degraded"
# R2_STORAGE_CAP_GB=        # teto de ocupação do R2; ≥ 80% vira "degraded"
# STRIPE_WEBHOOK_MAX_SILENCE_HOURS=24
# FAL_IMAGE_COST_USD=0.03   # preço por imagem na estimativa (sem FAL_ADMIN_KEY)
